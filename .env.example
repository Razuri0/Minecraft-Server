### --- Run `make setup` to create .env file using this template --- ###
# or manually create and copy this file to .env
# then fill in your values:

# .env is gitignored, so changes can be pulled from the repo without overwriting your values.

# ---- General ----

# Host user/group the containers run as (non-root).
# Find yours with:  id -u  and  id -g
PUID=1000
PGID=1000

# ---- Minecraft ----

# Domain players connect with; must resolve to this host (e.g. mysub.duckdns.org)
MC_DOMAIN=mc.example.com

# Minecraft version, e.g. 1.21.11 or LATEST
MC_VERSION=LATEST

# Server type: VANILLA, FABRIC, NEOFORGE or FORGE
MC_TYPE=VANILLA

# Mod loader version for the chosen MC_TYPE (ignored for VANILLA).
# Leave empty for latest (Fabric/NeoForge) or recommended (Forge).
MOD_LOADER_VERSION=

# RAM for the server Container
# default: 1G
MC_MEMORY=

# Put in the URL to your packwiz pack here - leave empty if you don't use packwiz.
# if using packwiz with the miniserve container, use:
# http://miniserve:8080/<insert pack name>/pack.toml
PACKWIZ_URL=

# CPUs to pin the server to, for multi-CPU (NUMA) machines.
# Set automatically by running:  make setup
# (or manually: lscpu | grep -i 'numa node0', e.g. MC_CPUSET=0-15,32-47)
# Leave empty on single-CPU machines to use all cores.
MC_CPUSET=

# ---- DuckDNS ----

# Your timezone
TZ=Europe/Berlin

# Your DuckDNS subdomain (without .duckdns.org)
DUCKDNS_SUBDOMAINS=

# Your DuckDNS token
DUCKDNS_TOKEN=

# ---- Server.properties ----

# Server name (MOTD)
# default: A Minecraft Server
MOTD=

# Server difficulty: peaceful, easy, normal, hard
# default: easy
DIFFICULTY=

# Game mode: survival, creative, adventure, spectator
# default: survival
GAMEMODE=

# Maximum number of players
# default: 20
MAX_PLAYERS=

# Render and Simulation distance (in chunks)
# default: render distance = 10, simulation distance = 10
VIEW_DISTANCE=
SIMULATION_DISTANCE=

# Allow flight (true/false)
# default: false (may kick players in false positive cases)
ALLOW_FLIGHT=

# Hardcore mode (true/false)
# default: false
HARDCORE=

# Maximum time (in ms) a single tick may take before the server watchdog stops the server with a crash report.
# For modded servers, or weak machines, you may want to increase this value or set it to 0 to disable the watchdog completely
# default: 60000
MAX_TICK_TIME=